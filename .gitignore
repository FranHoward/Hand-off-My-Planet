# Unreal Engine: generated binaries, caches, logs, autosaves and test backups.
# These directory names also apply inside plugins.
Binaries/
DerivedDataCache/
Intermediate/
Saved/
DerivedDataBackendGraph/

# Redistributable Python runtime generated by Scripts/build_runtime.py.
# Keep its source, dependency lock and original gesture models in Git.
/Plugins/CosmoBridge/Resources/Runtime/Win64/

# Python environments, bytecode and tool caches.
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
dist/

# Local IDE files and generated Visual Studio project files.
.vs/
.idea/
.vscode/
*.sln
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.code-workspace

# Compiled objects, debug symbols and packaged Unreal output.
*.obj
*.o
*.pch
*.pdb
*.ilk
*.exp
*.idb
*.ipch
*.pak
*.utoc
*.ucas

# Local credentials and environment settings; keep example configuration.
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.p12
*.pfx

# OS clutter, editor backups and the redundant original service archive.
.DS_Store
Thumbs.db
Desktop.ini
*.log
*.tmp
*.bak
*.blend1
*.blend2
/External/cosmo-system.zip

# Intentionally tracked: Content (including maps/external actors), plugin
